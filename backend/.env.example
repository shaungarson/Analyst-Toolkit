# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:5173 if unset (local dev).
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Free API key from https://www.alphavantage.co/support/#api-key (no credit card required).
# Used server-side only for the DCF module's ticker-search company data - never exposed to
# the frontend. Required for the "Load Company" feature; the rest of the app works without it.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
